# Copy to .env and fill in what you use. Everything here is optional:
# with an empty .env the app runs on 127.0.0.1 with a SQLite file in ./data,
# prepares applications, and saves email applications as drafts.
# .env is git-ignored. Never commit it.
# Each line shows the default, commented out. A blank value counts as unset.

# --- where things live ------------------------------------------------------
# JOBPORTAL_DATA_DIR=data
# JOBPORTAL_DATABASE_URL=postgresql+psycopg://jobportal:CHANGE_ME@localhost:5432/jobportal
# JOBPORTAL_TIMEZONE=UTC                 # e.g. America/Chicago; used for dates shown in the app

# --- the web app -------------------------------------------------------------
# JOBPORTAL_HOST=127.0.0.1
# JOBPORTAL_PORT=8000
# Required before the app will listen on anything but 127.0.0.1. At least 8 characters.
# JOBPORTAL_PASSWORD=
# Signs the session cookie. Generated into the data folder when unset. At least 32 characters.
# JOBPORTAL_SECRET_KEY=
# Names the app may be reached under besides localhost (JSON list).
# JOBPORTAL_ALLOWED_HOSTS=["jobs.home.example"]
# Behind a TLS reverse proxy: send the cookie over https only, and say which
# proxy addresses may be believed about who is connecting (comma-separated).
# JOBPORTAL_COOKIE_SECURE=false
# JOBPORTAL_TRUSTED_PROXIES=127.0.0.1

# --- outgoing mail: sends email applications as you --------------------------
# Gmail: create an app password (Google Account > Security > 2-Step Verification
# > App passwords) and use it here; your normal password will not work.
# JOBPORTAL_SMTP_HOST=smtp.gmail.com
# JOBPORTAL_SMTP_PORT=587
# JOBPORTAL_SMTP_SECURITY=starttls       # starttls (587) or ssl (465)
# JOBPORTAL_SMTP_USERNAME=you@gmail.com
# JOBPORTAL_SMTP_PASSWORD=
# JOBPORTAL_MAIL_FROM=you@gmail.com      # defaults to the email in your profile

# --- incoming mail: reads recruiter requirements and replies (read-only) -----
# Point the folder at a label that holds recruiter mail, not your whole inbox.
# JOBPORTAL_IMAP_HOST=imap.gmail.com
# JOBPORTAL_IMAP_PORT=993
# JOBPORTAL_IMAP_USERNAME=you@gmail.com
# JOBPORTAL_IMAP_PASSWORD=
# JOBPORTAL_IMAP_FOLDER=INBOX

# --- optional: Claude --------------------------------------------------------
# Only used to reword selected resume bullets, and only when LLM_REPHRASE is on.
# Every rewrite must pass the fact guard or the original text is kept.
# ANTHROPIC_API_KEY=
# JOBPORTAL_LLM_MODEL=claude-sonnet-5-5
# JOBPORTAL_LLM_REPHRASE=false

# --- crawler -----------------------------------------------------------------
# How the crawler names itself to the sites it reads, and the name it answers
# to in their robots.txt.
# JOBPORTAL_USER_AGENT=YuktivaJobPortal/0.1 (+https://github.com/sankar276/yuktivajobportal)
# JOBPORTAL_ROBOTS_TOKEN=YuktivaJobPortal
# JOBPORTAL_PER_HOST_DELAY_SECONDS=1.0
# JOBPORTAL_CRAWL_WORKERS=4
# JOBPORTAL_HTTP_TIMEOUT_SECONDS=20      # per read
# JOBPORTAL_HTTP_DEADLINE_SECONDS=120    # per response, however slowly it arrives
# JOBPORTAL_HTTP_MAX_RESPONSE_BYTES=30000000
# JOBPORTAL_HTTP_MAX_ATTEMPTS=3

# --- browser -----------------------------------------------------------------
# JOBPORTAL_CHROMIUM_PATH=/path/to/chrome
# JOBPORTAL_HEADLESS=true
# auto: use Chromium's sandbox where it starts (not as root, not in most
# containers) and say so in the log where it does not. true: refuse to run
# without it. false: never try.
# JOBPORTAL_CHROMIUM_SANDBOX=auto
# Lets the crawler and the browser reach localhost and private addresses.
# Only for tests and local demos.
# JOBPORTAL_ALLOW_LOCAL_ADDRESSES=false

# --- docker compose only -----------------------------------------------------
# POSTGRES_PASSWORD=
