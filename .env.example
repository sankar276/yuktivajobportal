# Copy to .env and fill in what you use. Everything here is optional:
# with an empty .env the app runs on 127.0.0.1 with a SQLite file in ./data,
# prepares applications, and saves email applications as drafts.
# .env is git-ignored. Never commit it.

# --- where things live ------------------------------------------------------
# JOBPORTAL_DATA_DIR=data
# JOBPORTAL_DATABASE_URL=postgresql+psycopg://jobportal:CHANGE_ME@localhost:5432/jobportal
# JOBPORTAL_TIMEZONE=America/Chicago

# --- the web app -------------------------------------------------------------
# Required before the app will listen on anything but 127.0.0.1.
# JOBPORTAL_PASSWORD=
# Names the app may be reached under besides localhost (JSON list).
# JOBPORTAL_ALLOWED_HOSTS=["jobs.home.example"]

# --- outgoing mail: sends email applications as you --------------------------
# Gmail: create an app password (Google Account > Security > 2-Step Verification
# > App passwords) and use it here; your normal password will not work.
# JOBPORTAL_SMTP_HOST=smtp.gmail.com
# JOBPORTAL_SMTP_PORT=587
# JOBPORTAL_SMTP_SECURITY=starttls
# JOBPORTAL_SMTP_USERNAME=you@gmail.com
# JOBPORTAL_SMTP_PASSWORD=
# JOBPORTAL_MAIL_FROM=you@gmail.com

# --- incoming mail: reads recruiter requirements and replies (read-only) -----
# Point the folder at a label that holds recruiter mail, not your whole inbox.
# JOBPORTAL_IMAP_HOST=imap.gmail.com
# JOBPORTAL_IMAP_USERNAME=you@gmail.com
# JOBPORTAL_IMAP_PASSWORD=
# JOBPORTAL_IMAP_FOLDER=Recruiters

# --- optional: Claude --------------------------------------------------------
# Only used to reword selected resume bullets, and only when LLM_REPHRASE is on.
# Every rewrite must pass the fact guard or the original text is kept.
# ANTHROPIC_API_KEY=
# JOBPORTAL_LLM_MODEL=claude-sonnet-5-5
# JOBPORTAL_LLM_REPHRASE=false

# --- crawler -----------------------------------------------------------------
# JOBPORTAL_PER_HOST_DELAY_SECONDS=1.0
# JOBPORTAL_CRAWL_WORKERS=4

# --- browser -----------------------------------------------------------------
# JOBPORTAL_CHROMIUM_PATH=/path/to/chrome

# --- docker compose only -----------------------------------------------------
# POSTGRES_PASSWORD=
